{
  "name": "@vault-mcp-bridge/server",
  "version": "0.1.2",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/index.ts",
    "dev:stdio": "tsx src/stdio.ts",
    "pairing-code": "tsx src/cli.ts pairing-code",
    "private-import": "tsx src/cli.ts private-import",
    "revoke-device": "tsx src/cli.ts revoke-device",
    "lint": "eslint src test",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@modelcontextprotocol/node": "2.0.0",
    "@modelcontextprotocol/server": "2.0.0",
    "@vault-mcp-bridge/contracts": "workspace:*",
    "fastify": "^5.3.3",
    "jose": "^6.0.10",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.20.3",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
