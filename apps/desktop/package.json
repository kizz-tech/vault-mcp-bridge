{
  "name": "@vault-mcp-bridge/desktop",
  "productName": "Vault Bridge",
  "version": "0.1.2",
  "private": true,
  "description": "Vault Bridge macOS desktop shell",
  "type": "module",
  "main": "dist/main.js",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.js"
    }
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build": "pnpm run typecheck && pnpm run bundle:main && pnpm run bundle:preload && pnpm run compile:renderer && pnpm run copy-static",
    "bundle:main": "node scripts/bundle-main.mjs",
    "bundle:preload": "esbuild src/preload.ts --bundle --platform=node --format=cjs --target=node24 --conditions=development --external:electron --outfile=dist/preload.cjs",
    "compile:renderer": "tsc -p tsconfig.renderer.json --noEmit && esbuild src/renderer/app.ts --bundle --platform=browser --format=esm --target=es2023 --outfile=dist/renderer/app.js",
    "copy-static": "node scripts/copy-static.mjs",
    "dev": "pnpm run build && electron dist/main.js",
    "smoke:main": "VAULT_BRIDGE_NO_BOOT=1 VAULT_BRIDGE_SMOKE_MAIN=1 electron dist/main.js",
    "start": "electron dist/main.js",
    "lint": "eslint src tests",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "package": "pnpm run build && pnpm run prepare:dmg-native && electron-forge make",
    "package:dir": "pnpm run build && electron-forge package",
    "prepare:dmg-native": "node scripts/prepare-dmg-native.mjs"
  },
  "dependencies": {
    "@vault-mcp-bridge/agent-core": "workspace:*",
    "@vault-mcp-bridge/agent": "workspace:*",
    "@vault-mcp-bridge/contracts": "workspace:*",
    "@vault-mcp-bridge/deployment": "workspace:*",
    "@vault-mcp-bridge/orchestrator": "workspace:*",
    "@peculiar/x509": "^1.14.0",
    "jose": "^6.0.10"
  },
  "devDependencies": {
    "@electron-forge/cli": "^7.11.2",
    "@electron-forge/maker-dmg": "^7.11.2",
    "@electron-forge/maker-zip": "^7.11.2",
    "@electron/fuses": "^2.1.3",
    "@types/node": "^24.0.0",
    "electron": "^43.2.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
