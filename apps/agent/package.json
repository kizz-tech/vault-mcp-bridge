{
  "name": "@vault-mcp-bridge/agent",
  "version": "0.1.2",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/private-sync.ts",
      "development": "./src/private-sync.ts",
      "import": "./dist/src/private-sync.js"
    }
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/main.ts",
    "private-sync": "tsx src/private-sync-main.ts",
    "lint": "eslint src tests",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@vault-mcp-bridge/agent-core": "workspace:*",
    "@fastify/static": "^10.1.2",
    "@vault-mcp-bridge/contracts": "workspace:*",
    "@vault-mcp-bridge/vault-core": "workspace:*",
    "fastify": "^5.4.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.20.3",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
