# Copy to a local, untracked environment file only after reviewing the threat
# model. This file contains no usable secret. Never put a real vault path,
# token, key, domain, or certificate in source control.

# ---------------------------------------------------------------------------
# Development / synthetic fixture only
# ---------------------------------------------------------------------------
NODE_ENV=development
SERVER_HOST=127.0.0.1
SERVER_PORT=8787
SERVER_DATABASE_PATH=.data/vault-mcp-bridge.sqlite
ALLOWED_HOSTS=127.0.0.1,localhost
ALLOWED_ORIGINS=http://127.0.0.1:8787,http://localhost:8787
MCP_HOSTS=127.0.0.1,localhost
PUBLISHER_HOSTS=127.0.0.1,localhost

# Empty disables MCP access. Set an explicit disposable value only for local
# synthetic testing; never use development auth on an internet-facing host.
MCP_DEV_TOKEN=
MCP_VAULT_ID=
MCP_READS_DISABLED=false
PUBLISHER_INGEST_DISABLED=false
# Synthetic development-only HMAC inputs. Production accepts file-backed
# values only and requires distinct secrets for these two trust surfaces.
PUBLISHER_EDGE_ATTESTATION_SECRET=
MCP_EDGE_ATTESTATION_SECRET=

# Development limits. Keep them bounded; lower values are safer.
PAIRING_TTL_SECONDS=600
MAX_BODY_BYTES=16842752
MAX_SNAPSHOT_BYTES=16777216
MAX_DOCUMENT_BYTES=262144
MAX_SEARCH_QUERY_BYTES=512
MAX_SEARCH_RESULTS=10
MAX_FETCH_BYTES=262144
MAX_CLOCK_SKEW_SECONDS=300
MAX_REQUEST_SECONDS=30
REQUEST_RATE_PER_MINUTE=60
REQUEST_BURST=20
MAX_CONCURRENT_PER_PRINCIPAL=4

# Local agent state is outside the vault. Leave blank to use the OS state
# directory. The agent must bind loopback unless an explicit development flag
# is set.
BRIDGE_DATA_DIR=
BRIDGE_HOST=127.0.0.1
BRIDGE_PORT=3210
BRIDGE_UNSAFE_DEV=0
BRIDGE_ALLOW_LOOPBACK_HTTP=1

# ---------------------------------------------------------------------------
# Production placeholders — configure via a secret manager, not this file.
# ---------------------------------------------------------------------------
# NODE_ENV=production
# SERVER_HOST=0.0.0.0
# SERVER_PORT=8787
# SERVER_DATABASE_PATH=/var/lib/vault-mcp-bridge/vault.sqlite
# ALLOWED_HOSTS=mcp.example.invalid,ingest.example.invalid,admin.example.invalid
# ALLOWED_ORIGINS=https://admin.example.invalid
# MCP_HOSTS=mcp.example.invalid
# PUBLISHER_HOSTS=ingest.example.invalid
# MCP_RESOURCE_URL=https://mcp.example.invalid/mcp
# PUBLISHER_PUBLIC_URL=https://ingest.example.invalid
# MCP_VAULT_ID=vault_replace_with_normalized_opaque_id
# JWT_ISSUER=https://issuer.example.invalid/
# JWT_AUDIENCE=replace-with-client-audience
# JWT_JWKS_URL=https://issuer.example.invalid/.well-known/jwks.json
# JWT_SCOPE=vault:read
# MCP_READS_DISABLED=false
# JWT_JWKS_FILE=/run/secrets/oauth_verification_bundle
# PUBLISHER_EDGE_ATTESTATION_SECRET_FILE=/run/secrets/publisher_edge_attestation
# MCP_EDGE_ATTESTATION_SECRET_FILE=/run/secrets/mcp_edge_attestation
# MAX_MCP_EDGE_ATTESTATION_ENTRIES=10000
#
# Managed edge process (separate host/container):
# EDGE_ORIGIN=https://edge.example.invalid
# EDGE_ISSUER=https://edge.example.invalid
# EDGE_PROVIDER=cloudflare
# EDGE_STATE_FILE=/var/lib/vault-mcp-bridge-edge/state.json
# EDGE_CREDENTIAL_VAULT_FILE=/var/lib/vault-mcp-bridge-edge/credentials.json
# EDGE_CREDENTIAL_MASTER_KEY_FILE=/run/secrets/edge_credential_master_key
# EDGE_CLOUDFLARE_API_TOKEN_FILE=/run/secrets/cloudflare_api_token
# EDGE_CLOUDFLARE_ACCOUNT_ID=replace-with-account-id
# EDGE_CLOUDFLARE_ZONE_ID=replace-with-zone-id
# EDGE_CLOUDFLARE_ZONE_NAME=example.invalid
# EDGE_OWNER_ISSUER=https://identity.example.invalid/
# EDGE_OWNER_AUDIENCE=vault-bridge-edge
# EDGE_OWNER_AUTHORIZATION_URL=https://identity.example.invalid/authorize
# EDGE_OWNER_TOKEN_ENDPOINT=https://identity.example.invalid/token
# EDGE_OWNER_CLIENT_ID=replace-with-public-desktop-client-id
# EDGE_OWNER_JWKS={"keys":[]}
#
# Publisher mTLS/service-auth material is intentionally not represented here.
# Provision it through the edge/secret manager and fail closed when absent.
# The local agent's Ed25519 private key belongs in the OS Keychain, never in
# this file, the vault, a container image, or shell history.
